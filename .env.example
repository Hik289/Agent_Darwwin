# Copy to .env and fill in your credentials
# The code reads these via os.environ in core/llm_client.py

# Azure OpenAI endpoint (e.g. https://your-resource.services.ai.azure.com/openai/v1)
AZURE_ENDPOINT=YOUR_AZURE_ENDPOINT

# Azure OpenAI API key
AZURE_API_KEY=YOUR_AZURE_API_KEY

# Model deployment name (default: gpt-5.4-mini)
AZURE_MODEL=gpt-5.4-mini

# Optional: alternative providers (not used by default but referenced by some scripts)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
