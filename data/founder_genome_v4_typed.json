{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentspecies/founder_genome/v4_typed",
  "genome_version": "0.4.0-founder-v4-typed-L12-task_focus-balanced",
  "lineage_id": "founder_v4_typed",
  "parent_ids": [],
  "supersedes": "v3_typed",
  "_comment": "Founder genome v4_typed \u2014 fork of v3_typed with rebalanced niche multiplier table. v3 used uniform \u00d710 matched multiplier, but v10 (cell_3_v10) collapsed to a retrieval-specialist monoculture by gen 27: PB baseline q=0.15 \u2192 matched F\u22481.5 vs HotpotQA baseline q=0.45 \u2192 matched F\u22484.5, a 3\u00d7 fitness gap that drove selection sweep toward retrieval. v4 rebalances multipliers inversely proportional to per-niche baseline q so that all three matched specialists land at F* \u2248 4.5: planning \u00d730 on PB (30\u00d70.15=4.5), memory \u00d715 on LoCoMo (15\u00d70.30=4.5), retrieval \u00d710 on HotpotQA (10\u00d70.45=4.5). Mismatch \u00d70.3 and generalist \u00d71 unchanged.",
  "modules": {
    "planner": {
      "module_id": "P",
      "module_type": "planner",
      "family": "plan_execute",
      "depth": 1,
      "replan_on_failure": false,
      "decomposition_style": "flat",
      "max_subgoals": 1,
      "prompt_template_id": "planner_v1_minimal",
      "output_ports": {
        "plan": {
          "type": "PlanSpec",
          "schema_ref": "schemas/PlanSpec.v1.json"
        }
      },
      "input_ports": {
        "goal": {
          "type": "GoalSpec",
          "schema_ref": "schemas/GoalSpec.v1.json"
        },
        "context": {
          "type": "EnvContext",
          "schema_ref": "schemas/EnvContext.v1.json"
        },
        "context_chain": {
          "type": "CompiledToolChain",
          "schema_ref": "schemas/CompiledToolChain.v1.json"
        }
      },
      "_mutation_ops": [
        "replace_module",
        "modify_param",
        "modify_tool_interface(out)"
      ],
      "input_type": "task_spec",
      "output_type": "plan_v_linear"
    },
    "workflow": {
      "module_id": "W",
      "module_type": "workflow",
      "representation": "typed_dag",
      "nodes": [
        {
          "id": "planner",
          "module_ref": "P"
        },
        {
          "id": "retriever",
          "module_ref": "M"
        },
        {
          "id": "executor",
          "module_ref": "T"
        },
        {
          "id": "verifier",
          "module_ref": "V"
        },
        {
          "id": "task_router",
          "module_ref": "TR"
        },
        {
          "id": "tool_chain_compiler",
          "module_ref": "TCC"
        },
        {
          "id": "evidence_aggregator",
          "module_ref": "EA"
        },
        {
          "id": "error_log",
          "module_ref": "EL"
        },
        {
          "id": "memory_compactor",
          "module_ref": "MC"
        }
      ],
      "edges": [
        {
          "src": "planner",
          "dst": "retriever",
          "port_src": "plan",
          "port_dst": "query"
        },
        {
          "src": "retriever",
          "dst": "executor",
          "port_src": "context",
          "port_dst": "context"
        },
        {
          "src": "planner",
          "dst": "executor",
          "port_src": "plan",
          "port_dst": "plan"
        },
        {
          "src": "executor",
          "dst": "verifier",
          "port_src": "observation",
          "port_dst": "observation"
        },
        {
          "src": "task_router",
          "dst": "planner",
          "port_src": "routed_task",
          "port_dst": "goal"
        },
        {
          "src": "tools",
          "dst": "tool_chain_compiler",
          "port_src": "tool_bundle",
          "port_dst": "tool_specs"
        },
        {
          "src": "tool_chain_compiler",
          "dst": "planner",
          "port_src": "compiled_chain",
          "port_dst": "context"
        },
        {
          "src": "planner",
          "dst": "evidence_aggregator",
          "port_src": "plan",
          "port_dst": "plan_outputs"
        },
        {
          "src": "evidence_aggregator",
          "dst": "verifier",
          "port_src": "aggregated",
          "port_dst": "evidence"
        },
        {
          "src": "verifier",
          "dst": "error_log",
          "port_src": "feedback",
          "port_dst": "event"
        },
        {
          "src": "error_log",
          "dst": "update_policy",
          "port_src": "summary",
          "port_dst": "error_summary"
        },
        {
          "src": "memory",
          "dst": "memory_compactor",
          "port_src": "context",
          "port_dst": "memory_snapshot"
        },
        {
          "src": "memory_compactor",
          "dst": "memory",
          "port_src": "compacted",
          "port_dst": "compacted_load"
        }
      ],
      "entry_node": "task_router",
      "exit_node": "verifier",
      "_comment": "v1 removes the verifier->executor feedback loop edge. Without replan_on_failure + samples=3 the loop is meaningless. Mutation can reintroduce it via add_workflow_edge. | v2_typed adds 5 modules (task_router\u2192planner, tool_chain_compiler\u2192planner, planner\u2192evidence_aggregator\u2192verifier, verifier\u2192error_log\u2192update_policy, memory\u2194memory_compactor) giving L=12 module count and 13 typed edges (4 v1 + 9 new). Max lineage-divergent epistatic edges C(L,2)=66 vs C(7,2)=21 in v1.",
      "_mutation_ops": [
        "add_workflow_node",
        "delete_workflow_node",
        "rewire_workflow_edge"
      ],
      "input_type": "plan_v_linear",
      "output_type": "action_seq"
    },
    "memory": {
      "module_id": "M",
      "module_type": "memory",
      "representation": "episodic",
      "store_backend": "in_process_dict",
      "retrieval": "hybrid",
      "retrieval_components": [
        "bm25",
        "embedding_cosine"
      ],
      "embedding_model": "text-embedding-3-small",
      "top_k": 6,
      "write_policy": "verified_only",
      "schema": {
        "key_type": "episode_id",
        "value_type": "EpisodeRecord",
        "fields": [
          "observation",
          "action",
          "outcome",
          "step",
          "tags"
        ]
      },
      "output_ports": {
        "context": {
          "type": "RetrievedContext",
          "schema_ref": "schemas/RetrievedContext.v1.json"
        }
      },
      "input_ports": {
        "query": {
          "type": "RetrieverQuery",
          "schema_ref": "schemas/RetrieverQuery.v1.json"
        },
        "compacted_load": {
          "type": "CompactedMemory",
          "schema_ref": "schemas/CompactedMemory.v1.json"
        }
      },
      "_mutation_ops": [
        "replace_module",
        "modify_memory_schema",
        "modify_param"
      ],
      "input_type": "action_seq",
      "output_type": "memory_chunk"
    },
    "tools": {
      "module_id": "T",
      "module_type": "tool_executor",
      "enabled": [
        "search",
        "python_exec",
        "file_reader",
        "web_browser_step",
        "noop"
      ],
      "router": "confidence_gated",
      "router_threshold": 0.55,
      "tool_specs": {
        "search": {
          "schema_id": "tool.search.v1",
          "input": "Query",
          "output": "SearchResults"
        },
        "python_exec": {
          "schema_id": "tool.python.v1",
          "input": "Code",
          "output": "ExecResult"
        },
        "file_reader": {
          "schema_id": "tool.file.v1",
          "input": "FilePath",
          "output": "FileBytes"
        },
        "web_browser_step": {
          "schema_id": "tool.webnav.v1",
          "input": "WebAction",
          "output": "WebObservation"
        },
        "noop": {
          "schema_id": "tool.noop.v1",
          "input": "Unit",
          "output": "Unit"
        }
      },
      "max_tool_calls_per_step": 1,
      "input_ports": {
        "plan": {
          "type": "PlanSpec",
          "schema_ref": "schemas/PlanSpec.v1.json"
        },
        "context": {
          "type": "RetrievedContext",
          "schema_ref": "schemas/RetrievedContext.v1.json"
        },
        "feedback": {
          "type": "VerifierFeedback",
          "schema_ref": "schemas/VerifierFeedback.v1.json"
        }
      },
      "output_ports": {
        "observation": {
          "type": "ExecObservation",
          "schema_ref": "schemas/ExecObservation.v1.json"
        },
        "tool_bundle": {
          "type": "ToolSpecBundle",
          "schema_ref": "schemas/ToolSpecBundle.v1.json"
        }
      },
      "_mutation_ops": [
        "modify_tool_interface",
        "modify_param",
        "replace_module"
      ],
      "input_type": "task_spec",
      "output_type": "tool_result"
    },
    "verifier": {
      "module_id": "V",
      "module_type": "verifier",
      "family": "self_consistency",
      "samples": 1,
      "voting": "any_valid",
      "critic_prompt_template_id": "verifier_v1_minimal",
      "stopping_rule": {
        "type": "score_threshold_or_budget",
        "score_threshold": 0.7,
        "max_total_steps": 4
      },
      "input_ports": {
        "observation": {
          "type": "ExecObservation",
          "schema_ref": "schemas/ExecObservation.v1.json"
        },
        "evidence": {
          "type": "AggregatedEvidence",
          "schema_ref": "schemas/AggregatedEvidence.v1.json"
        }
      },
      "output_ports": {
        "feedback": {
          "type": "VerifierFeedback",
          "schema_ref": "schemas/VerifierFeedback.v1.json"
        },
        "final": {
          "type": "FinalAnswer",
          "schema_ref": "schemas/FinalAnswer.v1.json"
        }
      },
      "_comment": "v1: samples=1 means there is nothing to vote on; voting=any_valid is a no-op single-sample 'accept if not malformed' rule. max_total_steps lowered 12\u21924 since no replan loop.",
      "_mutation_ops": [
        "replace_module",
        "modify_verifier_or_stopping",
        "modify_param"
      ],
      "input_type": "plan_v_linear",
      "output_type": "verify_result"
    },
    "communication": {
      "module_id": "C",
      "module_type": "communication",
      "schema": "claim_evidence_confidence",
      "message_format": {
        "fields": [
          "claim",
          "evidence",
          "confidence"
        ],
        "confidence_range": [
          0.0,
          1.0
        ]
      },
      "encoder_id": "comm_encoder_v0_default",
      "decoder_id": "comm_decoder_v0_default",
      "_mutation_ops": [
        "modify_communication_schema",
        "modify_param"
      ],
      "input_type": "verify_result",
      "output_type": "response"
    },
    "update_policy": {
      "module_id": "U",
      "module_type": "self_update",
      "mutation_distribution": {
        "replace_module": 0.0756,
        "add_workflow_node": 0.0378,
        "delete_workflow_node": 0.0378,
        "rewire_workflow_edge": 0.1134,
        "modify_param": 0.2268,
        "modify_tool_interface": 0.0756,
        "modify_memory_schema": 0.0756,
        "modify_communication_schema": 0.0378,
        "modify_verifier_or_stopping": 0.0756,
        "mutate_output_type": 0.072,
        "mutate_input_type": 0.072,
        "mutate_task_focus": 0.1
      },
      "mutation_rate_mu": 0.05,
      "schema_validation": "strict",
      "type_checking": "strict",
      "minimal_execution_test": true,
      "input_type": "verify_result",
      "output_type": "genome_update",
      "input_ports": {
        "error_summary": {
          "type": "ErrorSummary",
          "schema_ref": "schemas/ErrorSummary.v1.json"
        }
      },
      "_mutation_v3_note": "mutate_task_focus added at 0.10 prob; remaining ops rescaled to 0.90\u00d7 their v2 values to keep sum=1.0."
    },
    "evidence_aggregator": {
      "module_id": "EA",
      "module_type": "evidence_aggregator",
      "aggregation_method": "voting",
      "confidence_calibration": "raw",
      "tie_breaking": "score_max",
      "evidence_window": "recent_3",
      "input_ports": {
        "plan_outputs": {
          "type": "PlanOutputs",
          "schema_ref": "schemas/PlanOutputs.v1.json"
        }
      },
      "output_ports": {
        "aggregated": {
          "type": "AggregatedEvidence",
          "schema_ref": "schemas/AggregatedEvidence.v1.json"
        }
      },
      "input_type": "plan_v_linear",
      "output_type": "aggregated_evidence_v1",
      "_mutation_ops": [
        "replace_module",
        "modify_param",
        "mutate_input_type",
        "mutate_output_type"
      ]
    },
    "tool_chain_compiler": {
      "module_id": "TCC",
      "module_type": "tool_chain_compiler",
      "compile_method": "sequential",
      "error_handling": "abort",
      "result_merge": "first_success",
      "dependency_resolution": "static",
      "input_ports": {
        "tool_specs": {
          "type": "ToolSpecBundle",
          "schema_ref": "schemas/ToolSpecBundle.v1.json"
        }
      },
      "output_ports": {
        "compiled_chain": {
          "type": "CompiledToolChain",
          "schema_ref": "schemas/CompiledToolChain.v1.json"
        }
      },
      "input_type": "tool_result",
      "output_type": "compiled_chain_v1",
      "_mutation_ops": [
        "replace_module",
        "modify_param",
        "modify_tool_interface",
        "mutate_input_type",
        "mutate_output_type"
      ]
    },
    "error_log": {
      "module_id": "EL",
      "module_type": "error_log",
      "log_format": "jsonl",
      "verbosity": "standard",
      "retention_policy": "last_session",
      "aggregation_window": "per_task",
      "input_ports": {
        "event": {
          "type": "VerifierEvent",
          "schema_ref": "schemas/VerifierEvent.v1.json"
        }
      },
      "output_ports": {
        "summary": {
          "type": "ErrorSummary",
          "schema_ref": "schemas/ErrorSummary.v1.json"
        }
      },
      "input_type": "verify_result",
      "output_type": "error_summary_v1",
      "_mutation_ops": [
        "replace_module",
        "modify_param",
        "mutate_input_type",
        "mutate_output_type"
      ]
    },
    "task_router": {
      "module_id": "TR",
      "module_type": "task_router",
      "routing_policy": "confidence_based",
      "feature_extractor": "embedding",
      "fallback_strategy": "default_planner",
      "update_frequency": "never",
      "input_ports": {
        "raw_task": {
          "type": "RawTask",
          "schema_ref": "schemas/RawTask.v1.json"
        }
      },
      "output_ports": {
        "routed_task": {
          "type": "RoutedTask",
          "schema_ref": "schemas/RoutedTask.v1.json"
        }
      },
      "input_type": "raw_task",
      "output_type": "routed_task_v1",
      "_mutation_ops": [
        "replace_module",
        "modify_param",
        "mutate_input_type",
        "mutate_output_type"
      ]
    },
    "memory_compactor": {
      "module_id": "MC",
      "module_type": "memory_compactor",
      "compact_strategy": "lru",
      "compact_trigger": "size_threshold",
      "summary_method": "extractive",
      "retention_ratio": "ratio_0_5",
      "input_ports": {
        "memory_snapshot": {
          "type": "MemorySnapshot",
          "schema_ref": "schemas/MemorySnapshot.v1.json"
        }
      },
      "output_ports": {
        "compacted": {
          "type": "CompactedMemory",
          "schema_ref": "schemas/CompactedMemory.v1.json"
        }
      },
      "input_type": "memory_chunk",
      "output_type": "compacted_memory_v1",
      "_mutation_ops": [
        "replace_module",
        "modify_param",
        "modify_memory_schema",
        "mutate_input_type",
        "mutate_output_type"
      ]
    }
  },
  "validation_rules": {
    "module_count": 12,
    "required_modules": [
      "planner",
      "workflow",
      "memory",
      "tools",
      "verifier",
      "communication",
      "update_policy",
      "evidence_aggregator",
      "tool_chain_compiler",
      "error_log",
      "task_router",
      "memory_compactor"
    ],
    "interface_typing": "strict_typed_ports",
    "cross_module_constraints": [
      "planner.output_ports.plan.type == tools.input_ports.plan.type",
      "memory.output_ports.context.type == tools.input_ports.context.type",
      "tools.output_ports.observation.type == verifier.input_ports.observation.type",
      "verifier.output_ports.feedback.type == tools.input_ports.feedback.type",
      "task_router.output_type == planner.input_type_for(task_router_edge) or task_router.output_ports.routed_task.type == planner.input_ports.goal.type",
      "tools.output_ports.tool_bundle.type == tool_chain_compiler.input_ports.tool_specs.type",
      "tool_chain_compiler.output_ports.compiled_chain.type == planner.input_ports.context_chain.type",
      "planner.output_ports.plan.type == evidence_aggregator.input_ports.plan_outputs.type",
      "evidence_aggregator.output_ports.aggregated.type == verifier.input_ports.evidence.type",
      "verifier.output_ports.feedback.type == error_log.input_ports.event.type",
      "error_log.output_ports.summary.type == update_policy.input_ports.error_summary.type",
      "memory.output_ports.context.type == memory_compactor.input_ports.memory_snapshot.type",
      "memory_compactor.output_ports.compacted.type == memory.input_ports.compacted_load.type"
    ],
    "field_value_ranges": {
      "planner.depth": {
        "type": "int",
        "min": 1,
        "max": 12
      },
      "planner.max_subgoals": {
        "type": "int",
        "min": 1,
        "max": 16
      },
      "memory.top_k": {
        "type": "int",
        "min": 1,
        "max": 32
      },
      "tools.router_threshold": {
        "type": "float",
        "min": 0.0,
        "max": 1.0
      },
      "tools.max_tool_calls_per_step": {
        "type": "int",
        "min": 1,
        "max": 4
      },
      "verifier.samples": {
        "type": "int",
        "min": 1,
        "max": 7
      },
      "verifier.stopping_rule.score_threshold": {
        "type": "float",
        "min": 0.0,
        "max": 1.0
      },
      "verifier.stopping_rule.max_total_steps": {
        "type": "int",
        "min": 1,
        "max": 50
      },
      "update_policy.mutation_rate_mu": {
        "type": "float",
        "min": 0.0,
        "max": 0.5
      }
    },
